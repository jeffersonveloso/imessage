+// How CKKSTLKShare dataForSigning: appends one extra CKRecord value. References,
+// lists, locations and assets are not signed.
+fn tlkshare_extra_field_bytes(value: &cloudkit_proto::record::field::Value, epoch: f64) -> Option<Vec<u8>> {
+    match value.r#type? {
+        t if t == FieldType::StringType as i32 => Some(value.string_value.as_ref()?.as_bytes().to_vec()),
+        t if t == FieldType::BytesType as i32 => value.bytes_value.clone(),
+        t if t == FieldType::Int64Type as i32 => Some((value.signed_value? as u64).to_le_bytes().to_vec()),
+        t if t == FieldType::DoubleType as i32 => Some((value.double_value? as u64).to_le_bytes().to_vec()),
+        t if t == FieldType::DateType as i32 => {
+            // NSISO8601DateFormatter default: yyyy-MM-dd'T'HH:mm:ssZ in GMT
+            let secs = epoch + value.date_value.as_ref()?.time?;
+            let date = DateTime::<Utc>::from_timestamp(secs.trunc() as i64, 0)?;
+            Some(date.format("%Y-%m-%dT%H:%M:%SZ").to_string().into_bytes())
+        }
+        _ => None,
+    }
